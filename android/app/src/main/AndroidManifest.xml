<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The scan flow needs the camera (same reason the desktop build's
         Info.plist carries NSCameraUsageDescription — see BUILD.md). Not
         `required` at the manifest level so the app still installs on a
         camera-less device/emulator; MainActivity requests it at runtime
         and the scan UI degrades if it's denied, same as the browser
         getUserMedia() prompt would on desktop. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- First launch downloads the card catalog (see Downloader.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets MainActivity ask before the download uses mobile data, and notice when Wi-Fi arrives. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the in-app updater open the system installer on the APK it downloaded (ApkUpdater.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name="com.chaquo.python.android.PyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Binder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Binder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
