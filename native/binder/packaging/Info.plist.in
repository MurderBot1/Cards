<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Binder</string>
    <key>CFBundleDisplayName</key><string>Binder</string>
    <key>CFBundleIdentifier</key><string>com.bindercardtracker.binder</string>
    <key>CFBundleExecutable</key><string>binder</string>
    <key>CFBundleIconFile</key><string>icon.icns</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key><string>@PROJECT_VERSION@</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Scanning uses the camera through the web view. macOS refuses camera access to any app without this key,
         regardless of what the user clicks on the permission prompt. -->
    <key>NSCameraUsageDescription</key><string>Binder uses your camera to scan trading cards.</string>
</dict>
</plist>
